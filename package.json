{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node --no-deprecation node_modules/nuxt/bin/nuxt.mjs build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs --host 0.0.0.0",
    "build:start": "node --no-deprecation node_modules/nuxt/bin/nuxt.mjs build && node .output/server/index.mjs --host 0.0.0.0",
    "clean": "nuxt cleanup && rimraf .output dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/icon": "^2.6.2",
    "@nuxt/image": "^2.2.1",
    "@nuxt/ui": "^4.12.0",
    "chalk": "^6.0.1",
    "nuxt": "^4.6.4",
    "sharp": "^0.35.5",
    "tailwind-scrollbar": "^4.0.2",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.151",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "rimraf": "^6.1.4",
    "vitest": "^5.0.0"
  }
}
