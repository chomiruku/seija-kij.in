{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node --no-deprecation node_modules/nuxt/bin/nuxt.mjs build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs --host 0.0.0.0",
    "build:start": "node --no-deprecation node_modules/nuxt/bin/nuxt.mjs build && node .output/server/index.mjs --host 0.0.0.0",
    "clean": "nuxt cleanup && rimraf .output dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/eslint": "latest",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/image": "latest",
    "@nuxt/ui": "^4.5.1",
    "chalk": "latest",
    "eslint": "latest",
    "nuxt": "^4.4.2",
    "sharp": "latest",
    "tailwind-scrollbar": "latest",
    "vue": "^3.5.30",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.97",
    "@playwright/test": "^1.58.2",
    "@types/chalk": "^2.2.4",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.8.4",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.0"
  }
}
